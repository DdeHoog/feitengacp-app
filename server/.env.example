# Example environment variables for the Feitengacp backend.
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# Runtime
NODE_ENV=development
PORT=5000

# Exact Online OAuth2 app credentials.
# Use a separate Exact app registration for development (ngrok callback)
# vs. production (client domain callback).
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://iritic-yanira-postgenital.ngrok-free.dev/oauth/callback

# Secret used to sign JWTs issued by /api/login. Use a long random string.
JWT_SECRET=

# Path to the Exact OAuth token store. Dev and prod MUST NOT share this file.
# If unset, the server falls back to <server>/tokens.json (current behavior).
# Examples:
#   TOKEN_PATH=./storage/tokens.dev.json
#   TOKEN_PATH=/var/lib/feitengacp/tokens.prod.json
TOKEN_PATH=

# Comma-separated list of origins allowed by CORS.
# If unset, the server falls back to the built-in production origins.
# Example for local dev:
#   ALLOWED_ORIGINS=http://localhost:3000,https://iritic-yanira-postgenital.ngrok-free.dev
ALLOWED_ORIGINS=

# Set when the server sits behind a reverse proxy (nginx, Caddy, Cloudflare).
# Required for express-rate-limit to identify clients by real IP via
# X-Forwarded-For. Common values:
#   TRUST_PROXY=1          # trust 1 upstream hop (typical nginx-in-front-of-node)
#   TRUST_PROXY=loopback   # only trust 127.0.0.1
#   TRUST_PROXY=true       # trust all proxies (rarely correct)
# Leave unset for dev or when Express binds the public port directly.
TRUST_PROXY=
